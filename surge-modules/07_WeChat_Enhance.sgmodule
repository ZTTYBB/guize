[Script]
微信外部链接解锁 = type=http-response,pattern=^https\:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\?,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/Weixin_external_links_unlock.js
EMS中国邮政物流速递去广告 = type=http-response,pattern=^https:\/\/ump\.ems\.com\.cn\/new-generation-extend\/redis\/pageInfoByChannel,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/EMS.js
全家微会员去广告 = type=http-response,pattern=^https:\/\/minifm\.maxxipoint\.com\/banner\/list,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/FamilyMart.js
罗森点点去广告 = type=http-response,pattern=^https:\/\/lawsonapi\.yorentown\.com\/area\/sh-lawson\/app\/v1\/home,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/LAWSON.js
茶颜悦色去广告 = type=http-response,pattern=^https:\/\/miniapp\.sexytea2013\.com\/cms\/slot\/queryByCodes\?codes=INDEX_TOP_BANNER,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/Chayanyuese.js
COCO点单去广告 = type=http-response,pattern=^https:\/\/coco-com\.e\.verystar\.net\/v1\/home\/info,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/CoCo.js
滴滴青桔去广告 = type=http-response,pattern=^https:\/\/htwkop\.xiaojukeji\.com\/gateway\?api=hm\.fa\.homeConfig,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/Qingju.js
一点点+去广告 = type=http-response,pattern=^https:\/\/cappapi\.alittle-tea\.com\/open\?method=catering\.set\.ad,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/AlittleTea_T3.js
M = type=http-response,pattern=^https:\/\/api\.prod\.dj\.mstand\.cn\/scrm\/mini\/app\/index\/info,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/MStand.js
T3出行去广告 = type=http-response,pattern=^https:\/\/passenger\.t3go\.cn\/(solution\-|common\-)?(passenger\-)?(activity\-|app\-)?api\/notoken\/(trip\/)?api\/(home\/|common\/)?(v[1-3]\/)?(ad\/getNegativescreen|solution\/passenger\/open\/getHomeMenu|leftmenu|getHomeInfoGlobal),requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/AlittleTea_T3.js
古茗去广告 = type=http-response,pattern=^https:\/\/newton\.gumingnc\.com\/newton-buyer\/newton\/buyer\/(ump|touch|external\/front),requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/Guming.js
美团小程序tap优化 = type=http-response,pattern=^https:\/\/web\.meituan\.com\/api\/miniprogram\/tabbar\/all\/query,requires-body=1,max-size=0,script-path=https://resource.wuyra.com/Script/WeChat/WexinMiniPrograms/MeiTuan.js
